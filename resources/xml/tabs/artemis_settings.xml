<brls:Box width="auto" height="auto">
    <brls:ScrollingFrame width="auto" height="auto" axis="column" alignItems="stretch" grow="1.0">
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            <brls:Header title="Artemis Stream Tuning"/>
            <brls:DetailCell id="active_profile"/>
            <brls:BooleanCell id="custom_resolution"/>
            <brls:DetailCell id="custom_width"/>
            <brls:DetailCell id="custom_height"/>
            <brls:DetailCell id="exact_bitrate"/>

            <brls:Header title="Frame Rate and Video" paddingTop="60" lineTop="1px"/>
            <brls:SelectorCell id="frame_rate"/>
            <brls:BooleanCell id="unlock_high_fps"/>
            <brls:BooleanCell id="force_full_range"/>
            <brls:BooleanCell id="prevent_packet_loss"/>

            <brls:Header title="Presentation" paddingTop="60" lineTop="1px"/>
            <brls:SelectorCell id="scale_mode"/>
            <brls:BooleanCell id="remember_zoom_pan"/>
            <brls:DetailCell id="reset_zoom_pan"/>

            <brls:Header title="Switch Motion" paddingTop="60" lineTop="1px"/>
            <brls:BooleanCell id="forward_motion"/>
            <brls:BooleanCell id="console_motion_fallback"/>

            <brls:Header title="Notes" paddingTop="60" lineTop="1px"/>
            <brls:Label
                text="Resolution, frame rate and bitrate changes apply when a stream starts or restarts. Optional feature controls are enabled only when their feature PR is present. Sunshine hosts continue to use the standard GameStream path."
                width="auto"
                height="auto"
                fontSize="22"
                marginTop="16"/>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
