<brls:Box
    width="auto"
    height="auto">
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0" >
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            <brls:Header title="@i18n/streaming/input"/>
            <brls:DetailCell id="input_overlay"/>
            <brls:Header title="@i18n/settings/mouse_input" paddingTop="60"/>
            <brls:SelectorCell id="mouse_input_time"/>
            <brls:DetailCell id="mouse_input_buttons"/>
            <brls:SelectorCell id="keyboard_type"/>
            <brls:SelectorCell id="keyboard_fingers"/>
            <brls:DetailCell id="options_pointer_mode"/>
            <brls:DetailCell id="options_controllers"/>

            <brls:Header id="host_integration_header" title="@i18n/artemis/overlay/host_integration" paddingTop="60"/>
            <brls:DetailCell id="options_clipboard"/>

            <brls:Header title="@i18n/artemis/overlay/artemis_settings" paddingTop="60"/>
            <brls:DetailCell id="options_display"/>
            <brls:BooleanCell id="options_low_latency_pacing"/>
            <brls:BooleanCell id="options_full_range"/>
            <brls:BooleanCell id="options_volume_amp"/>

            <brls:Header title="@i18n/settings/guide_key" paddingTop="60"/>
            <brls:DetailCell id="guide_key_buttons"/>
            <brls:SelectorCell id="guide_by_system_button"/>

            <brls:Header id="image_adjustments_header" title="@i18n/settings/image_adjustments" paddingTop="60" lineTop="1px"/>
            <BooleanSliderCell id="dithering"/>
            <brls:BooleanCell id="upscaling"/>
            <brls:SelectorCell id="upscaling_mode"/>
            <BooleanSliderCell id="rcas"/>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
