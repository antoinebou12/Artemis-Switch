<brls:Box width="auto" height="auto">
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            <brls:Header title="@i18n/artemis/overlay/quick_actions"/>
            <brls:DetailCell id="quick_keyboard"/>
            <brls:DetailCell id="quick_move_left"/>
            <brls:DetailCell id="quick_move_right"/>
            <brls:DetailCell id="quick_touch"/>
            <brls:DetailCell id="quick_host_shortcuts"/>
            <brls:DetailCell id="quick_server_commands"/>
            <brls:DetailCell id="quick_mouse"/>
            <brls:Header id="volume_header" paddingTop="60" title="@i18n/streaming/volume"/>
            <brls:Slider id="volume_slider" width="auto" height="84"/>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
