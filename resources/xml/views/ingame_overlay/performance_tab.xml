<brls:Box width="auto" height="auto">
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            <brls:Header title="@i18n/artemis/performance/title"/>
            <brls:DetailCell id="network"/>
            <brls:DetailCell id="wifi_signal"/>
            <WifiPerformanceGraph
                id="wifi_graph"
                width="auto"
                height="96"
                marginTop="8"
                marginBottom="16"/>
            <brls:DetailCell id="receive_latency"/>
            <brls:DetailCell id="decode_latency"/>
            <brls:DetailCell id="render_latency"/>
            <brls:DetailCell id="packet_loss"/>
            <brls:DetailCell id="host_fps"/>
            <brls:DetailCell id="received_fps"/>
            <brls:DetailCell id="decoded_fps"/>
            <brls:DetailCell id="rendered_fps"/>
            <brls:DetailCell id="frame_queue"/>
            <brls:DetailCell id="gpu_render"/>
            <brls:DetailCell id="presentation"/>
            <brls:Header title="@i18n/artemis/performance/switch_runtime" paddingTop="60" lineTop="1px"/>
            <brls:DetailCell id="operation_mode"/>
            <brls:DetailCell id="cpu_clock"/>
            <brls:DetailCell id="gpu_clock"/>
            <brls:DetailCell id="memory_clock"/>
            <brls:DetailCell id="battery"/>
            <brls:Header title="@i18n/artemis/performance/benchmark" paddingTop="60" lineTop="1px"/>
            <brls:DetailCell id="benchmark_summary"/>
            <brls:DetailCell id="benchmark_action"/>
            <brls:DetailCell id="benchmark_save"/>
            <brls:DetailCell id="benchmark_reset"/>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
