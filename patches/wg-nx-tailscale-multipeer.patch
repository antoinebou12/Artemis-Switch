+int wg_connect_peer(WgTunnel* tun, WgPeer* peer) {
+    if (!tun || !peer || !peer->configured || !tun->running)
+        return WG_ERR_INVALID_CONFIG;
+    if (tun->socket_fd < 0) {
+        const int socket_result = wg_socket_open(tun);
+        if (socket_result != WG_OK) return socket_result;
+    }
+
+    peer->connected = true;
+    for (int attempt = 0; attempt < WG_MAX_TIMER_HANDSHAKES; attempt++) {
+        WgHandshakeInit message;
+        crypto_wipe(&peer->pending_hs, sizeof(peer->pending_hs));
+        peer->hs_pending = true;
+        const int init_result = wg_handshake_init_peer(
+            tun, peer, &message, &peer->pending_hs);
+        if (init_result != WG_OK) return init_result;
+
+        wg_mutex_lock(&tun->send_mutex);
+        const int sent = wg_socket_send_to(
+            tun, peer->relay_hash, &message, sizeof(message));
+        wg_mutex_unlock(&tun->send_mutex);
+        crypto_wipe(&message, sizeof(message));
+        if (sent < 0) return WG_ERR_SOCKET;
+
+        for (int elapsed = 0; elapsed < WG_REKEY_TIMEOUT * 1000;
+             elapsed += 10) {
+            if (peer->session.valid) {
+                wg_mutex_lock(&tun->send_mutex);
+                wg_send_keepalive_to_peer(tun, peer);
+                wg_mutex_unlock(&tun->send_mutex);
+                return WG_OK;
+            }
+            wg_sleep_ms(10);
+        }
+    }
+    peer->connected = false;
+    peer->hs_pending = false;
+    return WG_ERR_TIMEOUT;
+}
