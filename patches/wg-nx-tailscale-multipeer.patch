+int wg_update_peer(WgTunnel* tun, WgPeer* peer,
+                   const uint8_t public_key[WG_KEY_LEN]) {
+    if (!tun || !peer || !peer->configured || !public_key)
+        return WG_ERR_INVALID_CONFIG;
+    wg_mutex_lock(&tun->send_mutex);
+    crypto_wipe(&peer->session, sizeof(peer->session));
+    crypto_wipe(&peer->prev_session, sizeof(peer->prev_session));
+    crypto_wipe(&peer->pending_hs, sizeof(peer->pending_hs));
+    memcpy(peer->public_key, public_key, WG_KEY_LEN);
+    peer->connected = false;
+    peer->hs_pending = false;
+    wg_mutex_unlock(&tun->send_mutex);
+    return WG_OK;
+}
+
+int wg_remove_peer(WgTunnel* tun, WgPeer* peer) {
+    if (!tun || !peer || !peer->configured)
+        return WG_ERR_INVALID_CONFIG;
+    wg_mutex_lock(&tun->send_mutex);
+    peer->configured = false;
+    crypto_wipe(peer, sizeof(*peer));
+    wg_mutex_unlock(&tun->send_mutex);
+    return WG_OK;
+}
