+static int append_bytes(uint8_t **buffer, size_t *buffer_len,
+                        const uint8_t *data, size_t data_len) {
+    if (data_len == 0) return 0;
+    if (*buffer_len > SIZE_MAX - data_len) return -1;
+    uint8_t *next = realloc(*buffer, *buffer_len + data_len);
+    if (!next) return -1;
+    memcpy(next + *buffer_len, data, data_len);
+    *buffer = next;
+    *buffer_len += data_len;
+    return 0;
+}
+
+static uint8_t* take_grpc_message(Conn *c, size_t *out_len,
+                                  char *error, size_t error_size) {
+    if (c->grpc_bytes_len < 5) return NULL;
+    if (c->grpc_bytes[0] != 0) {
+        snprintf(error, error_size, "compressed gRPC message unsupported");
+        return NULL;
+    }
+    size_t message_len = ((size_t)c->grpc_bytes[1] << 24) |
+                         ((size_t)c->grpc_bytes[2] << 16) |
+                         ((size_t)c->grpc_bytes[3] << 8) |
+                         (size_t)c->grpc_bytes[4];
+    if (message_len > 1024 * 1024) {
+        snprintf(error, error_size, "gRPC message too large: %zu", message_len);
+        return NULL;
+    }
+    if (c->grpc_bytes_len < 5 + message_len) return NULL;
+
+    uint8_t *message = malloc(message_len ? message_len : 1);
+    if (!message) {
+        snprintf(error, error_size, "malloc");
+        return NULL;
+    }
+    if (message_len) memcpy(message, c->grpc_bytes + 5, message_len);
+
+    size_t consumed = 5 + message_len;
+    size_t remaining = c->grpc_bytes_len - consumed;
+    if (remaining) memmove(c->grpc_bytes, c->grpc_bytes + consumed, remaining);
+    c->grpc_bytes_len = remaining;
+    *out_len = message_len;
+    return message;
+}
+
+uint8_t* h2_stream_recv(H2Conn *conn, uint32_t stream_id,
+                        size_t *out_len, char *error, size_t error_size) {
+    *out_len = 0;
+    *error = 0;
+    Conn *c = (Conn*)conn;
+    if (!c || !c->preface_done || stream_id == 0) {
+        snprintf(error, error_size, "stream not connected");
+        return NULL;
+    }
+
+    for (;;) {
+        uint8_t *message = take_grpc_message(c, out_len, error, error_size);
+        if (message) return message;
+        if (*error) return NULL;
+
+        size_t ws_len = 0;
+        uint8_t *ws = ws_recv(c, &ws_len);
+        if (!ws) {
+            snprintf(error, error_size, "signal stream disconnected");
+            return NULL;
+        }
+        if (append_bytes(&c->stream_bytes, &c->stream_bytes_len, ws, ws_len) != 0) {
+            free(ws);
+            snprintf(error, error_size, "stream buffer allocation");
+            return NULL;
+        }
+        free(ws);
+
+        size_t consumed = 0;
+        while (c->stream_bytes_len - consumed >= 9) {
+            const uint8_t *frame = c->stream_bytes + consumed;
+            uint32_t frame_len = ((uint32_t)frame[0] << 16) |
+                                 ((uint32_t)frame[1] << 8) | frame[2];
+            if (c->stream_bytes_len - consumed < 9 + frame_len) break;
+
+            uint8_t type = frame[3];
+            uint8_t flags = frame[4];
+            uint32_t sid = ((uint32_t)(frame[5] & 0x7f) << 24) |
+                           ((uint32_t)frame[6] << 16) |
+                           ((uint32_t)frame[7] << 8) | frame[8];
+            const uint8_t *payload = frame + 9;
+
+            if (type == 0 && sid == stream_id) {
+                if (append_bytes(&c->grpc_bytes, &c->grpc_bytes_len,
+                                 payload, frame_len) != 0) {
+                    snprintf(error, error_size, "gRPC buffer allocation");
+                    return NULL;
+                }
+            } else if (type == 6 && sid == 0 && frame_len == 8 && !(flags & 1)) {
+                if (h2_send_frame(c, 8, 6, 1, 0, payload) != 0) {
+                    snprintf(error, error_size, "PING acknowledgement failed");
+                    return NULL;
+                }
+            } else if (type == 7) {
+                snprintf(error, error_size, "Signal server sent GOAWAY");
+                return NULL;
+            }
+
+            if (sid == stream_id && (flags & 1)) {
+                snprintf(error, error_size, "Signal stream ended");
+                return NULL;
+            }
+            consumed += 9 + frame_len;
+        }
+
+        if (consumed) {
+            size_t remaining = c->stream_bytes_len - consumed;
+            if (remaining) memmove(c->stream_bytes, c->stream_bytes + consumed, remaining);
+            c->stream_bytes_len = remaining;
+        }
+    }
+}
